# Copy this file to ".env" and adjust the values.

# HTTP port
PORT=3000

# development | production | test
NODE_ENV=development

# Optional prefix for every route, e.g. /api  (leave empty to match the swagger paths exactly)
API_PREFIX=

# MongoDB Atlas connection string. LEAVE EMPTY to run with the hardcoded in-memory mock data.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/moviebuddy
MONGODB_URI=

# false = demo mode (no token needed, requests act as DEFAULT_USER_ID, ownership checks are relaxed)
# true  = every route except login/register/health needs "Authorization: Bearer <token>"
REQUIRE_AUTH=false
DEFAULT_USER_ID=1
TOKEN_TTL_HOURS=24

# Allowed CORS origin for the frontend (use * during development)
CORS_ORIGIN=*

# Default radius (km) used when suggesting profiles to swipe on
SUGGESTION_RADIUS_KM=50
